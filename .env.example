# WSMS Supply Chain ERP Configuration
# Copy this file to .env and adjust variables as needed

# Database Password
DB_PASSWORD=wsscms_password

# JWT Security Token Secret (Should be a strong hexadecimal string in production)
JWT_SECRET=ChangeThisSecretInProduction1234567890ABCDEF

# Backend Service URL (from host machine perspective)
BACKEND_API_URL=http://localhost:8081

# Prophet AI microservice URL (from host machine perspective)
PROPHET_SERVICE_API_URL=http://localhost:8000
