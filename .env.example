# =================================================================
# WSMS Enterprise ERP — Supply Chain Environment Configuration
# =================================================================
# Copy this template to .env and customize values for production

# PostgreSQL Database Configuration
POSTGRES_DB=wsscms_db
POSTGRES_USER=wsscms_user
DB_PASSWORD=wsscms_password
DB_PORT=5433

# JWT Security & Authentication Secrets
JWT_SECRET=ChangeThisSecretInProduction1234567890ABCDEF
JWT_REFRESH_SECRET=ChangeThisRefreshSecretInProduction987654321

# Microservice API Gateway & Gateway URLs
BACKEND_API_URL=http://localhost:8081
PROPHET_SERVICE_API_URL=http://localhost:8000

# CORS Security Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80
